# AndroidSecForge configuration — copy this file to .env and edit for your machine.
#   cp .env.example .env
# .env is gitignored; never commit machine-specific paths. All settings use the
# ASF_ prefix and are read by pydantic Settings (backend/app/core/config.py).
# Every optional tool degrades gracefully when unset — the pipeline still runs.
# Use plain KEY=value lines (no spaces around '='); this file is also sourced by
# backend/run-full-pipeline.sh.

# ---------------------------------------------------------------------------
# Database  (SQLite default; PostgreSQL for shared/multi-user)
# ---------------------------------------------------------------------------
# ASF_DATABASE_URL=sqlite:///./androidsecforge.db
# ASF_DATABASE_URL=postgresql+psycopg://androidsecforge:androidsecforge@localhost:5432/androidsecforge

# ---------------------------------------------------------------------------
# Storage  (where uploaded APKs and per-APK working dirs live)
# ---------------------------------------------------------------------------
# ASF_ARTIFACT_STORAGE_PATH=./artifacts
# ASF_WORKSPACE_PATH=./workspace

# ---------------------------------------------------------------------------
# jadx  — DEX -> Java decompilation (enables code index / graph / reachability)
# Download: https://github.com/skylot/jadx/releases  (needs Java 11+)
# Point at the launcher script, e.g. .../jadx/bin/jadx
# ---------------------------------------------------------------------------
# ASF_JADX_PATH=/opt/jadx/bin/jadx

# ---------------------------------------------------------------------------
# Ghidra  — native analysis
# Download: https://github.com/NationalSecurityAgency/ghidra/releases (needs JDK 21+)
# ASF_GHIDRA_PATH = the unzipped install dir (contains support/analyzeHeadless).
# (GHIDRA_INSTALL_DIR / GHIDRA_HOME are also honored if ASF_GHIDRA_PATH is unset.)
# ---------------------------------------------------------------------------
# ASF_GHIDRA_PATH=/opt/ghidra_11.3_PUBLIC
# Deep native call-chain + JNI reachability. SLOW: ~1 min per native library.
# ASF_GHIDRA_DEEP_ENABLED=true
# Legacy standalone per-library ghidra stage — redundant with deep, and its
# post-script needs porting to .java on Ghidra 12+. Leave off.
# ASF_GHIDRA_ENABLED=false

# ---------------------------------------------------------------------------
# Runtime (optional) — device/emulator via adb; live instrumentation via Frida
# ---------------------------------------------------------------------------
# ASF_FRIDA_PATH=/usr/local/bin/frida
# ASF_FRIDA_SERVER_PATH_ON_DEVICE=/data/local/tmp/frida-server

# ---------------------------------------------------------------------------
# Server — used by run-full-pipeline.sh
# ---------------------------------------------------------------------------
# ASF_HOST=127.0.0.1
# ASF_PORT=8000
# ASF_PYTHON=python3
